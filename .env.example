#-----------------------------------------------------------------------------------------------
#Begin by renaming this file to .env and filling in the appropriate values for your environment.
#-----------------------------------------------------------------------------------------------

# Application Secrets
SECRET_KEY=your_secret_key_here

# User Passwords
REPORTER_PASSWORD=your_reporter_password
REVIEWER_PASSWORD=your_reviewer_password

# Fuseki Database Settings
FUSEKI_BASE=http://localhost:3030
FUSEKI_ADMIN_USER=your_admin_username
FUSEKI_ADMIN_PASSWORD=your_admin_password

# AllegroGraph Credentials
# Must use https://
AG_BASE_URL=https://your-allegrograph-host:10035
AG_REPO=your_repository_name
AG_USER=your_allegrograph_username
AG_PASSWORD=your_allegrograph_password

# HTTPS / TLS
# Certificate and key for serving the Flask app over HTTPS (python app.py).
# If unset, a temporary self-signed cert is generated (local development only).
#TLS_CERT_FILE=/path/to/cert.pem
#TLS_KEY_FILE=/path/to/key.pem
# Set to 1 if a reverse proxy (nginx, Render, ...) terminates TLS in front of the app
TRUST_PROXY=0
# Optional: CA bundle to trust for upstream servers such as AllegroGraph (e.g. self-signed cert)
UPSTREAM_CA_BUNDLE=
